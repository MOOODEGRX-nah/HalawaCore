# Maintainer: MOOODEGRX-nah <https://github.com/MOOODEGRX-nah/HalawaCore/issues>
# Packaging recipe: MIT; see LICENSE. Upstream application: MIT.
pkgname=halawacore-bin
pkgver=0.3.2
pkgrel=1
pkgdesc='Local CPU topology and reversible process-affinity analyzer'
arch=('x86_64')
url='https://github.com/MOOODEGRX-nah/HalawaCore'
license=('MIT')
depends=('glibc>=2.35' 'zlib' 'xdg-utils' 'hicolor-icon-theme')
provides=("halawacore=${pkgver}")
conflicts=('halawacore')
# Stripping a PyInstaller executable can damage its embedded archive.
options=('!strip' '!debug')
source=(
  "HalawaCore-${pkgver}-Linux-x64.tar.gz::${url}/releases/download/v${pkgver}/HalawaCore-Linux-x64.tar.gz"
  'halawacore.desktop'
  'halawacore.svg'
  'LICENSE'
)
sha256sums=(
  'e938dbd6eb035f971bf94bffdbd88d2ab07ec0ba0c14798a8ed9219072a10bc5'
  '06c5bfa9a0b220a0a4df5b729bec201eea3acbaff32d4968239bc01d5cbeae1b'
  '2c6b4ed65388fbc179bdd3afec45fa5828284a18d1fe2874976d536cfc5515af'
  '5f0d73a2a84662105dff22f3d2348451a370f9e1ac56299e19c488ddd5d9f12b'
)

package() {
  install -Dm755 "${srcdir}/HalawaCore" "${pkgdir}/opt/halawacore/HalawaCore"
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/halawacore/HalawaCore "${pkgdir}/usr/bin/halawacore"
  install -Dm644 "${srcdir}/halawacore.desktop" \
    "${pkgdir}/usr/share/applications/halawacore.desktop"
  install -Dm644 "${srcdir}/halawacore.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/halawacore.svg"
  install -Dm644 "${srcdir}/LICENSE.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/READ-ME-FIRST.txt" \
    "${pkgdir}/usr/share/doc/${pkgname}/READ-ME-FIRST.txt"
  install -Dm644 "${srcdir}/verification.json" \
    "${pkgdir}/usr/share/doc/${pkgname}/verification.json"
}
